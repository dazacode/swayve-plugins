# ---------------------------------------------------------------------------
# Line-ending normalization is a CORRECTNESS requirement here, not cosmetics.
#
# The .swayveplugin bundle format is deterministic (see docs/packaging.md):
# entries sorted by path, fixed timestamps, fixed compression, and LF-normalized
# text files. The bundle digest in integrity.json is a sha256 over file
# contents, so a file that is CRLF in one checkout and LF in another produces a
# DIFFERENT digest for the same source. The maintainer develops on Windows and
# CI runs on Linux; without the rules below the same commit would package to two
# different digests and signature/checksum verification would fail.
#
# Rule: everything is LF in the repository and LF in the working tree.
# ---------------------------------------------------------------------------
* text=auto eol=lf

# Source and data — always text, always LF.
*.dart      text eol=lf diff=dart
*.json      text eol=lf
*.jsonc     text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf diff=markdown
*.txt       text eol=lf
*.sh        text eol=lf
*.lock      text eol=lf
*.sha256    text eol=lf

# Files without an extension that must still be normalized.
LICENSE     text eol=lf
NOTICE      text eol=lf
CODEOWNERS  text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# The published manifest schema. Normalized like any other JSON; called out
# separately because its bytes are part of the public contract
# (https://swayve.app/schema/swayve-plugin.schema.json).
schema/*.json text eol=lf linguist-language=JSON

# SVG is text (plugin icons are often SVG) — normalize it so an icon hashes the
# same on every platform. Do NOT mark it binary.
*.svg       text eol=lf

# Genuinely binary — never normalize, never diff, never merge.
*.swayveplugin binary
*.zip       binary
*.gz        binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.pdf       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary

# Windows-only scripts, if any are ever added, genuinely need CRLF.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# GitHub language stats: docs and generated fixtures are not the project.
docs/**     linguist-documentation
test/fixtures/** linguist-generated
